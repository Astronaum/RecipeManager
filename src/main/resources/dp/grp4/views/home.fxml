   <VBox fx:id="root" fx:controller="dp.grp4.views.HomeView" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
         minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0"  stylesheets="@styles/home.css"
         xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <styleClass>
      <String fx:value="bg-color"/>
   </styleClass>
   <HBox alignment="CENTER" prefHeight="238.0" prefWidth="481.0" spacing="20.0" >
      <VBox onMouseClicked="#gotoRecipes" alignment="CENTER" prefHeight="238.0" prefWidth="190.0" spacing="10.0">
         <styleClass>
            <String fx:value="home-button"/>
         </styleClass>
         <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@/images/recipe.png"/>
         </ImageView>
         <Label styleClass="home-button-label" text="Reciepes" textAlignment="CENTER" textFill="WHITE"/>
      </VBox>
      <VBox onMouseClicked="#gotoIngredients" alignment="CENTER" prefHeight="238.0" prefWidth="190.0" spacing="10.0">
         <styleClass>
            <String fx:value="home-button"/>
         </styleClass>
         <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
            <Image url="@/images/ingredients.png"/>
         </ImageView>
         <Label styleClass="home-button-label" text="Ingredients" textAlignment="CENTER" textFill="WHITE"/>
      </VBox>
   </HBox>
