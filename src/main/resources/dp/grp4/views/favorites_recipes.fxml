<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Label?>

<AnchorPane fx:id="root" prefHeight="600.0" prefWidth="800.0" stylesheets="@styles/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dp.grp4.views.FavoritesRecipesView">

    <Label text="Recettes Favorites" AnchorPane.topAnchor="20.0" AnchorPane.leftAnchor="20.0" styleClass="title-label" />
    <Button fx:id="viewRecipeButton" AnchorPane.topAnchor="20.0" AnchorPane.rightAnchor="20.0" onAction="#gotoRecipes" styleClass="action-button" text="Retour" />
    <Button fx:id="showHomeButton" AnchorPane.topAnchor="20.0" AnchorPane.rightAnchor="100.0" onAction="#goHome" styleClass="action-button" text="Accueil" />

    <TableView fx:id="favoritesTable" AnchorPane.topAnchor="60.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.bottomAnchor="20.0" styleClass="recipes-table">
        <columns>
            <TableColumn fx:id="nameColumn" text="Nom" />
            <TableColumn fx:id="prepTimeColumn" text="Temps de Préparation" />
            <TableColumn fx:id="difficultyColumn" text="Difficulté" />
            <TableColumn fx:id="categoryColumn" text="Catégorie" />
        </columns>
    </TableView>
</AnchorPane>
