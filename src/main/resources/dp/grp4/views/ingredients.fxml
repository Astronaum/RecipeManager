<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="root" prefHeight="600.0" prefWidth="800.0" stylesheets="@styles/styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dp.grp4.views.IngredientsView">

    <!-- Title -->
    <Text styleClass="title-label" text="Gestion des Ingrédients" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" />

    <!-- TableView to display ingredients -->
    <TableView fx:id="ingredientsTable" layoutX="20.0" layoutY="108.0" styleClass="ingredients-table" AnchorPane.bottomAnchor="62.66666666666674" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="108.0">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" />
            <TableColumn fx:id="nameColumn" text="Nom" />
            <TableColumn fx:id="stockColumn" text="Stock" />
            <TableColumn fx:id="unitColumn" text="Unité" />
            <TableColumn fx:id="expirationColumn" text="Expiration" />
            <TableColumn fx:id="actionColumn" text="Actions" />
        </columns>
    </TableView>

    <!-- Button to add a new ingredient -->
    <Button fx:id="addButton" layoutX="20.0" layoutY="552.0" onAction="#onAddIngredient" prefHeight="16.0" prefWidth="35.0" styleClass="action-button" text="+" AnchorPane.bottomAnchor="14.666666666666629" AnchorPane.leftAnchor="20.0" />
    <Button fx:id="homeButton" layoutX="680.0" layoutY="14.0" onAction="#gotoHome" prefWidth="100" styleClass="action-button" text="Home" AnchorPane.bottomAnchor="552.6666666666666" AnchorPane.rightAnchor="20.0" />
    <Button fx:id="viewRecipeButton" layoutX="547.0" layoutY="14.0" onAction="#gotoRecipes" styleClass="action-button" text="Voir les recettes" AnchorPane.rightAnchor="135.0" AnchorPane.topAnchor="14.0" />

</AnchorPane>
